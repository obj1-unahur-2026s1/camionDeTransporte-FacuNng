import cosas.*
import camion.*


describe "test camion" {
  
  method initialize(){
    bumblebee.cambiarForma(robot)
    arenaAGraner.peso(150)
    bateriaAntiaerea.cargarYDescargarMisiles()
    paqueteDeLadrillos.cambiarCantidadLadrillos(80)
    embalaje.cambiarEmbalaje(paqueteDeLadrillos)
    camion.cargarVariasCosas([bumblebee, arenaAGraner, bateriaAntiaerea, embalaje])
  }
  
  test "test peso camion" {
    // bumblebee = 800
    // arenaAGraner = 150
    //bateriaAntiaerea = 300
    //embalaje = 160
    assert.equals(1000+800+150+200+160  ,camion.peso())
  }

  test "test pesos pares" {
    assert.that(camion.todosLosPesosSonPares())
  }
}

